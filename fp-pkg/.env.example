# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=./data/fairpass.sqlite

# ---- Chain ----
# Sepolia RPC (Alchemy / Infura / public). Use http://127.0.0.1:8545 for a local Hardhat node.
RPC_URL=
# 11155111 = Sepolia, 31337 = Hardhat local
CHAIN_ID=11155111
# Fill in once Person 1/2 deploy the contract
CONTRACT_ADDRESS=
# Path to the compiled ABI (Hardhat artifact JSON or a bare ABI array)
CONTRACT_ABI_PATH=./abi/FairPass.abi.json
# Block the contract was deployed at (indexer starts scanning here)
START_BLOCK=0

# ---- Indexer ----
INDEXER_POLL_MS=6000
INDEXER_BATCH_SIZE=2000
# Only index blocks at least this deep, reducing reorg exposure
INDEXER_CONFIRMATIONS=2
# Maximum reorg depth (in blocks) the indexer will walk back through
INDEXER_MAX_REORG_DEPTH=64
# Start the indexer inside the API process (set false to run `npm run indexer` separately)
INDEXER_ENABLED=true

# ---- Contract function / argument name overrides (leave empty to auto-detect from the ABI) ----
FN_OWNER_OF=ownerOf
FN_CHECKED_IN=
FN_CAP_PERCENT=
FN_ROYALTY=
# Used ONLY if the contract exposes no cap / royalty getter
FALLBACK_CAP_PERCENT=
FALLBACK_ROYALTY_PERCENT=
# JSON merged over the default event-argument aliases, e.g. {"price":["faceValue"]}
EVENT_ARG_MAP_JSON=
# true if the contract holds listed NFTs in escrow (ownerOf(token) == contract while listed)
LISTING_ESCROW=false

# ---- Pinata / IPFS (server-side only, never expose to the frontend) ----
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud
# "ipfs" -> ipfs://<cid>   |   "gateway" -> <gateway>/ipfs/<cid>
TOKEN_URI_FORMAT=ipfs

# ---- Check-in ----
CHALLENGE_TTL_SECONDS=30
