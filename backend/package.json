{
  "name": "fairpass-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "indexer": "tsx src/scripts/indexer.ts",
    "demo": "tsx src/scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:chain": "node scripts/run-chain-tests.cjs",
    "start:prod": "node dist/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "ethers": "^6.17.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "hardhat": "^2.29.1",
    "qrcode": "^1.5.4",
    "solc": "^0.8.24",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
