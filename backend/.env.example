# API server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=./data/fairpass.sqlite

# Sepolia deployment defaults are loaded from ../deployments/sepolia.json.
# Set RPC_URL to your Sepolia RPC endpoint before starting the live API.
RPC_URL=
CHAIN_ID=11155111
CONTRACT_ADDRESS=0x6919957288D51D1b3A514AD2cbfF1Fb202418E5e
DEPLOYMENT_PATH=../deployments/sepolia.json
# Optional override. If empty, the ABI is loaded from DEPLOYMENT_PATH.
CONTRACT_ABI_PATH=
# Leave at 0 to resolve the deployment block from the deployment transaction receipt; set an explicit block to override.
START_BLOCK=0

# Indexer
INDEXER_ENABLED=true
INDEXER_POLL_MS=6000
INDEXER_BATCH_SIZE=2000
INDEXER_CONFIRMATIONS=2
INDEXER_MAX_REORG_DEPTH=64

# Pinata. Required for Sepolia NFT metadata uploads.
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud
TOKEN_URI_FORMAT=ipfs
# Only use local metadata mode with a local Hardhat chain (31337), never Sepolia.
METADATA_LOCAL_MODE=false
LOCAL_METADATA_BASE_URL=http://localhost:4000

# Venue/organizer signer used only by POST /api/checkin/confirm.
# Use a Sepolia test account or local Hardhat account, never a wallet holding real funds.
VENUE_PRIVATE_KEY=
CHALLENGE_TTL_SECONDS=30

# Optional compatibility overrides; not needed for the deployed TicketNFT ABI.
FN_OWNER_OF=ownerOf
FN_CHECKED_IN=used
LISTING_ESCROW=false
